--// INTRO VOICE: Welcome to 515
task.spawn(function()
    local success, err = pcall(function()
        local voice = Instance.new("AudioTextToSpeech")
        voice.Parent = workspace
        voice.Text = "Welcome to 515"
        voice.VoiceId = "3"
        voice.AutoLocalize = false
        voice.Pitch = -3
        voice.Speed = 0.85
        voice.Volume = 1.2

        local output = Instance.new("AudioDeviceOutput")
        output.Parent = workspace

        local wire = Instance.new("Wire")
        wire.SourceInstance = voice
        wire.TargetInstance = output
        wire.Parent = workspace

        local result = voice:LoadAsync()

        if result == Enum.AssetFetchStatus.Success then
            voice:Play()
        end
    end)

    if not success then
        warn("515 intro voice error:", err)
    end
end)

