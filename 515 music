--// Play and stop music
play.Activated:Connect(function()
    local id = idBox.Text:match("%d+")

    if not id then
        status.Text = "Enter a valid Audio ID!"
        return
    end

    music:Stop()
    music.SoundId = "rbxassetid://" .. id
    status.Text = "Loading music..."

    local success = pcall(function()
        music:Play()
    end)

    if success then
        status.Text = "Playing • 515"
    else
        status.Text = "Could not play this audio"
    end
end)

stop.Activated:Connect(function()
    music:Stop()
    status.Text = "Music stopped"
end)

--// Drag circle on touch or mouse
local dragging = false
local dragStart
local startPosition
local moved = false

circle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        moved = false
        dragStart = input.Position
        startPosition = circle.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        if delta.Magnitude > 8 then
            moved = true
        end

        circle.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)
